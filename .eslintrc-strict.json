{
	"extends": ["eslint:recommended", "plugin:@typescript-eslint/strict-type-checked"],
	"parser": "@typescript-eslint/parser",
	"parserOptions": {
		"ecmaVersion": 2020,
		"sourceType": "module",
		"project": "./tsconfig.json"
	},
	"plugins": ["@typescript-eslint", "obsidian-compat"],
	"env": {
		"node": true,
		"es2020": true
	}
}
