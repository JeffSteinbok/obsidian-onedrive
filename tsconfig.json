{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"experimentalDecorators": true,
		"lib": ["DOM", "ES5", "ES6", "ES7", "ES2022.Intl"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "dev", "tests"]
}
